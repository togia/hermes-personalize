# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored — never commit it.

my_ip_cidr         = "203.0.113.4/32" # your public IP, e.g. from `curl ifconfig.me`
key_name           = "your-ec2-keypair-name"
budget_alert_email = "you@example.com"

# Do NOT put openrouter_api_key here — pass it at apply time instead:
#   TF_VAR_openrouter_api_key="sk-or-..." terraform apply
